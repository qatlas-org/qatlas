QATLAS_VERSION=1.0.7-SNAPSHOT

BACKEND_PORT=1900
UI_PORT=80
CLASSIC_UI_PORT=1902

DB_HOST=mysql
DB_NAME=reports_db
DB_USER=reports_user
DB_PASSWORD=password

DATA_PATH=/var/lib/docker/volumes/reports_app_new/_data/data
ATTACHMENTS_PATH=/var/lib/docker/volumes/reports_app_new/_data/data/attachments

QATLAS_NETWORK=qatlas-test_default
DB_NETWORK=reports_default

JAVA_OPTS=-XX:+HeapDumpOnOutOfMemoryError -XX:HeapDumpPath=/app/data/hdump -Xmx1024m -XX:ReservedCodeCacheSize=32M -XX:MaxDirectMemorySize=10M