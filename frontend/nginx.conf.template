events{

}
http{
    include       mime.types;
    server {
        listen       ${LISTENING_PORT};
        listen  [::]:${LISTENING_PORT};
        server_name  localhost;
        root /usr/share/nginx/html;

        #charset koi8-r;
        #access_log  /var/log/nginx/host.access.log  main;

        location / {
            index index.html;
        }

        location /attachment/ {
            alias /app/data/attachments/;
        }

        location /rs/ {
            proxy_pass http://${BACKEND_SERVICE_NAME}:${BACKEND_SERVICE_PORT}/rs/;
        }

        location /v3/ {
            proxy_pass http://${BACKEND_SERVICE_NAME}:${BACKEND_SERVICE_PORT}/v3/;
        }

        error_page   500 502 503 504  /50x.html;
        location = /50x.html {
            root   /usr/share/nginx/html;
        }

    }
}
