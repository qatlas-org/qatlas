# Settings for docker-compose.full.yml (complete QAtlas on an empty server:
# MySQL + backend + classic UI + new UI + Adminer).
#
# Use:  copy this file to ".env" next to docker-compose.full.yml and
#       replace every CHANGE_ME. Never commit the real .env (it is git-ignored).
# Or let scripts/server-setup.sh do it for you (it creates strong passwords).

# Docker image version to run (qatlas/backend, qatlas/frontend, qatlas/qatlas-ui)
QATLAS_VERSION=1.1.1-SNAPSHOT

# Ports on the server
UI_PORT=80
CLASSIC_UI_PORT=1902
BACKEND_PORT=1900
ADMINER_PORT=9090

# Database
DB_NAME=reports_db
DB_USER=reports_user
DB_PASSWORD=password
DB_ROOT_PASSWORD=password

# Java memory for the backend
JAVA_OPTS=-XX:+HeapDumpOnOutOfMemoryError -XX:HeapDumpPath=/app/data/hdump -Xmx1024m -XX:ReservedCodeCacheSize=32M -XX:MaxDirectMemorySize=10M -Dspring.jpa.properties.hibernate.default_batch_fetch_size=100
