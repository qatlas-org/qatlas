# Copy this file to .env and adjust as needed.
# Everything here has a working default if you don't set it at all.

# Which published image version to pull (matches Maven release versions)
QATLAS_VERSION=1.0.0

# Ports exposed on YOUR machine - change these if they conflict with
# something else you're already running.
BACKEND_PORT=8080
UI_PORT=9092
LEGACY_UI_PORT=9091
ADMINER_PORT=9090

# Change this from the default in production.
MYSQL_PASSWORD=password
