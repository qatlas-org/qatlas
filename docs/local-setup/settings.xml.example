<?xml version="1.0" encoding="UTF-8"?>
<!--
  Copy this file to:
    Windows : %USERPROFILE%\.m2\settings.xml
    Linux   : ~/.m2/settings.xml
  and replace the values. NEVER commit the real file.

  The token comes from https://central.sonatype.com  > your account > "Generate User Token".
  (It is a token, not your login password.)
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0 https://maven.apache.org/xsd/settings-1.2.0.xsd">
    <servers>
        <!-- id must be "central": it matches distributionManagement in api-client/pom.xml -->
        <server>
            <id>central</id>
            <username>TOKEN_USERNAME</username>
            <password>TOKEN_PASSWORD</password>
        </server>
    </servers>

    <profiles>
        <profile>
            <id>gpg</id>
            <properties>
                <!-- Only needed if you have more than one GPG key -->
                <!-- <gpg.keyname>YOUR_KEY_ID</gpg.keyname> -->
            </properties>
        </profile>
    </profiles>
    <activeProfiles>
        <activeProfile>gpg</activeProfile>
    </activeProfiles>
</settings>
